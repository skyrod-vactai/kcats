[[evaluating? [[program] 🔍 [evaluate] starts?]]
 [with-innermost [[🔳 🔀
                   [[evaluating?]
                    [[stack 0] 👥 [🔍] 🪄 🔀 [🔗] 🪄 ] ;; append the next part of the path to the accumulator
                    ⏳ 🔀] 🛡️ ••🗑️]
                  🪄 ;; under the stepping prog
                  [update] •🛡️ flip 🗑️

                  ;; find which envs are finished and remove
                  ;; 'evaluate' from parent
                  [0 -2 slice 👥] [collect] ••🛡️ 
                  [[[[[evaluating?]
                      [[stack 0] 🔍 finished?]]
                     [▶️] 💯]
                    [[program] [rest] update]
                    when]
                   [update] •🛡️ flip 🗑️ 🗑️]
                  🪜]]]
🔗
