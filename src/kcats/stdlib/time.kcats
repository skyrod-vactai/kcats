[[milliseconds [[spec [[integer] [integer]]]
                [definition 🔳]]]

 [seconds [[spec [[integer] [integer]]]
           [definition [1000 *]]]]

 [minutes [[spec [[integer] [integer]]]
           [definition [seconds 60 *]]]]

 [hours [[spec [[integer] [integer]]]
         [definition [minutes 60 *]]]]

 [days [[spec [[integer] [integer]]]
        [definition [hours 24 *]]]]]
