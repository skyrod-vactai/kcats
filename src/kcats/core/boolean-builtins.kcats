[[✅ [[spec [🔳 [word]]]]] ;; self-inserts

 [and [[spec [[item item] [item]]]
       [examples [[[1 odd? 2 even? and] [✅]]
                  [[2 3 and] [3]]
                  [[🔳 3 and] [🔳]]
                  [["" 3 and] [🔳]]]]]]

 [or [[spec [[item item] [item]]]
      [examples [[[1 odd? 3 even? or] [✅]]
                 [[1 2 or] [1]]
                 [[🔳 2 or] [2]]
                 [[🔳 🔳 or] [🔳]]]]]]

 [☯️ [[spec [[item] [boolean]]]
     [examples [[[1 even? ☯️] [✅]]
                [[🔳 ☯️] [✅]]
                [[✅ ☯️] [🔳]]
                [[🔳 ☯️] [✅]]]]]]]
🔗
